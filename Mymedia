/* Reset & base */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
  background-color: #f0f2f5;
  color: #1c1e21;
}

/* Header */
header {
  background-color: #1877f2;
  color: white;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 30px;
}

.logo {
  font-size: 32px;
  font-weight: 700;
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

.login-form input {
  padding: 7px 12px;
  margin-left: 8px;
  border: none;
  border-radius: 6px;
  font-size: 14px;
  outline: none;
}

.login-form button {
  margin-left: 8px;
  padding: 7px 16px;
  background-color: #42b72a;
  border: none;
  border-radius: 6px;
  color: white;
  font-weight: 600;
  cursor: pointer;
  font-size: 14px;
}

.login-form button:hover {
  background-color: #36a420;
}

/* Main layout */
main {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding: 40px 30px;
  gap: 40px;
}

/* Left side */
.left-section {
  flex: 1;
  max-width: 450px;
  color: #1c1e21;
}

.left-section h1 {
  font-size: 48px;
  font-weight: 700;
  line-height: 1.1;
  margin-bottom: 30px;
}

.left-section img {
  max-width: 100%;
}

/* Right side signup */
.right-section {
  flex: 1;
  max-width: 420px;
  background-color: white;
  padding: 25px 30px;
  border-radius: 8px;
  box-shadow: 0 4px 12px rgb(0 0 0 / 0.15);
}

.signup-box h2 {
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 4px;
}

.signup-box p {
  font-size: 16px;
  margin-bottom: 20px;
  color: #606770;
}

form input[type="text"],
form input[type="email"],
form input[type="password"],
form select {
  width: 100%;
  padding: 14px 15px;
  margin-bottom: 15px;
  font-size: 16px;
  border: 1px solid #dddfe2;
  border-radius: 6px;
  outline: none;
  transition: border-color 0.3s;
}

form input[type="text"]:focus,
form input[type="email"]:focus,
form input[type="password"]:focus,
form select:focus {
  border-color: #1877f2;
}

.name-row {
  display: flex;
  gap: 10px;
}

.name-row input {
  flex: 1;
}

label {
  font-weight: 600;
  font-size: 14px;
  margin-bottom: 6px;
  display: block;
  color: #1c1e21;
}

.dob {
  display: flex;
  gap: 8px;
  margin-bottom: 15px;
}

.dob select {
  flex: 1;
}

.gender {
  display: flex;
  gap: 12px;
  margin-bottom: 20px;
